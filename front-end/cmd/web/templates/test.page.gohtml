{{template "base" .}}

{{define "content" }}
    <div class="container">
        <div class="row">
            <div class="col">
                <h1 class="mt-5">Test microservices</h1>
                <hr>
                <a id="brokerButton" class="btn btn-output-secondary" href="javascript:void(0);">Test Broker Service</a>
                <a id="authBrokerButton" class="btn btn-output-secondary" href="javascript:void(0);">Test Auth Service</a>
                <a id="loggerButton" class="btn btn-output-secondary" href="javascript:void(0);">Test Logger Service</a>
                <a id="grpcLogButton" class="btn btn-output-secondary" href="javascript:void(0);">Test Logger Service via gRPC</a>
                <a id="mailButton" class="btn btn-output-secondary" href="javascript:void(0);">Test Mail Service</a>

                <div id="output" class="mt-5" style="outline: 1px solid silver; padding: 2em;">
                    <span class="text-muted">Output shows here...</span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <h4 class="mt-5">Sent</h4>
                <div class="mt-1" style="outline: 1px solid silver; padding: 2em;">
                    <pre id="payload"><span class="text-muted">Nothing sent yet...</span></pre>
                </div>
            </div>
            <div class="col">
                <h4 class="mt-5">Received</h4>
                <div class="mt-1" style="outline: 1px solid silver; padding: 2em;">
                    <pre id="received"><span class="text-muted">Nothing received yet...</span></pre>
                </div>
            </div>
        </div>
    </div>
{{end}}

{{define "js"}}
    <script>
        let brokerButton = document.getElementById("brokerButton")
        let authBrokerButton = document.getElementById("authBrokerButton")
        let loggerButton = document.getElementById("loggerButton")
        let grpcLoggerButton = document.getElementById("grpcLogButton")
        let mailButton = document.getElementById("mailButton")
        let output = document.getElementById("output")
        let sent = document.getElementById("payload")
        let received = document.getElementById("received")

        mailButton.addEventListener("click", function() {
            const payload = {
                action: "mail",
                mail: {
                    from: "me@example.com",
                    to: "you@there.com",
                    subject:  "Test email",
                    message:  "Hello world!",
                }
            }

            const headers = new Headers();
            headers.append("Content-Type", "application/json")

            const body = {
                method: "POST", 
                body: JSON.stringify(payload),
                headers: headers
            }

            fetch({{print .BrokerURL "/handle"}}, body)
            .then((response) => response.json())
            .then((data) => {
                sent.innerHTML = JSON.stringify(payload, undefined, 4); 
                received.innerHTML = JSON.stringify(data, undefined, 4); 
                if (data.error) {
                    output.innerHTML += `<br><strong>Error:</strong> ${data.message}`;
                } else {
                    output.innerHTML += `<br><strong>Response from broker service</strong>: ${data.message}`;
                }
            })
            .catch((error) => {
                output.innerHTML += "<br><br>Error: " + error; 
            })
        })

        loggerButton.addEventListener("click", function() {
            const payload = {
                action: "log", 
                log: {
                    name: "event", 
                    data: "some data",
                }
            }


            const headers = new Headers();
            headers.append("Content-Type", "application/json")

             const body = {
                method: "POST", 
                body: JSON.stringify(payload),
                headers: headers
            }

            fetch({{print .BrokerURL "/handle"}}, body)
            .then((response) => response.json())
            .then((data) => {
                sent.innerHTML = JSON.stringify(payload, undefined, 4); 
                received.innerHTML = JSON.stringify(data, undefined, 4); 
                if (data.error) {
                    output.innerHTML += `<br><strong>Error:</strong> ${data.message}`;
                } else {
                    output.innerHTML += `<br><strong>Response from broker service</strong>: ${data.message}`;
                }
            })
            .catch((error) => {
                output.innerHTML += "<br><br>Error: " + error; 
            })
        })

        grpcLoggerButton.addEventListener("click", function() {
            const payload = {
                action: "log", 
                log: {
                    name: "GRPC event", 
                    data: "some gRPC data",
                }
            }

            const headers = new Headers();
            headers.append("Content-Type", "application/json")

             const body = {
                method: "POST", 
                body: JSON.stringify(payload),
                headers: headers
            }

            fetch({{print .BrokerURL "/log-grpc"}}, body)
            .then((response) => response.json())
            .then((data) => {
                sent.innerHTML = JSON.stringify(payload, undefined, 4); 
                received.innerHTML = JSON.stringify(data, undefined, 4); 
                if (data.error) {
                    output.innerHTML += `<br><strong>Error:</strong> ${data.message}`;
                } else {
                    output.innerHTML += `<br><strong>Response from broker service</strong>: ${data.message}`;
                }
            })
            .catch((error) => {
                output.innerHTML += "<br><br>Error: " + error; 
            })
        })

        authBrokerButton.addEventListener("click", function() {
            const payload = {
                action: "auth",
                auth: {
                    email: "admin@example.com",
                    password: "verysecret"
                }
            }

            const headers = new Headers();
            headers.append("Content-Type", "application/json")

            const body = {
                method: "POST", 
                body: JSON.stringify(payload),
                headers: headers
            }

            fetch({{print .BrokerURL "/handle"}}, body)
            .then((response) => response.json())
            .then((data) => {
                sent.innerHTML = JSON.stringify(payload, undefined, 4); 
                received.innerHTML = JSON.stringify(data, undefined, 4); 
                if (data.error) {
                    output.innerHTML += `<br><strong>Error:</strong> ${data.message}`;
                } else {
                    output.innerHTML += `<br><strong>Response from broker service</strong>: ${data.message}`;
                }
            })
            .catch((error) => {
                output.innerHTML += "<br><br>Error: " + error; 
            })
        })

        brokerButton.addEventListener("click", function() {
            const body = {
                method: 'POST',
            }

            console.log({{.BrokerURL}})

            fetch({{.BrokerURL}}, body)
            .then((response) => response.json())
            .then((data) => {
                sent.innerHTML = "empty post request"; 
                received.innerHTML = JSON.stringify(data, undefined, 4); 
                if (data.error) {
                    console.log(data.message); 
                } else {
                    output.innerHTML += `<br><strong>Response from broker service</strong>: ${data.message}`;
                }
            })
            .catch((error) => {
                output.innerHTML += "<br><br>Error: " + error; 
            })
        })
    </script>
{{end}}
